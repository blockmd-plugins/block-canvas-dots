{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-canvas-dots",
  "category": "appearance",
  "name": {
    "zh": "编辑器背景",
    "en": "Editor Background"
  },
  "version": "1.2.1",
  "author": "Block Community",
  "repo": "blockmd-plugins/block-canvas-dots",
  "summary": {
    "zh": "像纸质点阵手账本一样，给写作区或全屏窗口铺上对齐文字的点阵或方格底纹",
    "en": "Give your editor or full window a line-aligned dot or grid paper backdrop"
  },
  "entry": {
    "js": "main.js"
  },
  "permissions": [
    "storage",
    "ui:settings",
    "ui:appearance"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "记住你选好的底纹样式、深浅度和显示范围",
      "en": "Remember your chosen pattern, contrast level, and display scope"
    },
    "ui:settings": {
      "zh": "在设置页展示和切换点阵、方格底纹与显示范围",
      "en": "Configure dot or grid patterns, contrast, and display scope"
    },
    "ui:appearance": {
      "zh": "在编辑区或全屏窗口底层渲染点阵与方格背景",
      "en": "Render line-aligned dot or grid backdrops in the editor or full window"
    }
  },
  "surfaces": [
    "settings_page"
  ],
  "contributes": {
    "backdrops": [
      {
        "id": "paper-dots",
        "title": {
          "zh": "点阵纸纹",
          "en": "Dot Paper"
        },
